{
  "name": "rightseat-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Positive Rate verification automation: FAA registry syncs, Stripe Identity, AI document reading, rules, scheduled jobs.",
  "scripts": {
    "start": "node src/server.js",
    "jobs": "node src/jobs/scheduler.js",
    "sync:aircraft": "node src/jobs/run.js aircraft",
    "sync:airmen": "node src/jobs/run.js airmen",
    "sweep": "node src/jobs/run.js sweep",
    "test": "node --test test/*.test.js",
    "faa:verify": "node src/jobs/faa-verify.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "adm-zip": "^0.6.1",
    "csv-parse": "^7.0.3",
    "express": "^5.3.0",
    "node-cron": "^4.6.0",
    "stripe": "^23.1.0"
  }
}
